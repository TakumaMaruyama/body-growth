{
  "name": "@body-growth/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development PORT=${API_DEV_PORT:-3001} tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "NODE_ENV=${NODE_ENV:-production} node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@body-growth/api-contract": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.27.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "^3.1.0",
    "tsx": "^4.21.0"
