# PostgreSQL connection used by the API and migration runner.
DATABASE_URL=REPLACE_WITH_POSTGRESQL_CONNECTION_URL
# Optional in production when the database uses a private certificate authority.
DATABASE_SSL_CA=

# The first administrator is created once when no ADMIN account exists.
BODY_GROWTH_ADMIN_USERNAME=ADMIN_USERNAME
BODY_GROWTH_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# API server settings.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Development-only ports. The Vite server proxies /api to API_DEV_ORIGIN.
WEB_PORT=5173
API_DEV_PORT=3001
API_DEV_ORIGIN=http://127.0.0.1:3001